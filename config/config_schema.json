{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SmartSpirometerConfig",
  "description": "Schema cấu hình chung của nhóm (VIE-01). Mọi tham số phần cứng đọc từ đây, không hardcode trong mã.",
  "type": "object",
  "properties": {
    "sample_rate_hz":         { "type": "integer", "enum": [500] },
    "adc_bits":               { "type": "integer", "enum": [12] },
    "adc_divisor":            { "type": "integer", "enum": [4095, 4096], "description": "Quy ước mẫu số ADC. Nhóm dùng 4095." },
    "vref_v":                 { "type": "number", "minimum": 3.0, "maximum": 3.6 },
    "divider_ratio":          { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "Tỷ số danh định 2/3 = 0.666667" },
    "divider_ratio_measured": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1, "description": "Tỷ số đo thực tế từ Nhung (null = chưa đo, dùng danh định)" },
    "vs_nominal_v":           { "type": "number", "enum": [5.0] },
    "vs_measured_v":          { "type": ["number", "null"], "minimum": 4.5, "maximum": 5.5, "description": "Điện áp nuôi cảm biến thực tế (null = chưa đo)" },
    "sensor_model":           { "type": "string", "description": "Mã cảm biến thực gắn trên bo — cần Nhung xác nhận" },
    "sensor_offset_frac":     { "type": "number", "description": "Hàm truyền Vout = Vs*(sens*P_kPa + offset). MPXV7002DP: 0.5" },
    "sensor_sens_per_kpa":    { "type": "number", "exclusiveMinimum": 0, "description": "MPXV7002DP: 0.2 /kPa" },
    "zero_adc":               { "type": "integer", "minimum": 1800, "maximum": 2350, "description": "MPXV7002DP offset 2.25–2.75 V ở Vs=5 V -> 1861–2275 count sau phân áp 2/3; danh định 2068" },
    "zero_samples":           { "type": "integer", "minimum": 100 },
    "zero_max_std_count":     { "type": "number", "exclusiveMinimum": 0 },
    "filter_placement":       { "type": "string", "enum": ["pre_model", "post_model"] },
    "filter_live":            { "type": "string", "enum": ["none", "moving_average", "butterworth"] },
    "filter_offline":         { "type": "string", "enum": ["none", "moving_average", "butterworth", "savgol"] },
    "ma_window":              { "type": "integer", "minimum": 1 },
    "butter_order":           { "type": "integer", "minimum": 1, "maximum": 8 },
    "butter_fc_hz":           { "type": "number", "exclusiveMinimum": 0 },
    "savgol_window":          { "type": "integer", "minimum": 3 },
    "savgol_polyorder":       { "type": "integer", "minimum": 1 },
    "dp_deadband_pa":         { "type": "number", "minimum": 0, "description": "|ΔP| nhỏ hơn ngưỡng này coi như Q = 0 (giới hạn phân giải dòng thấp)" },
    "interp_max_gap_s":       { "type": "number", "exclusiveMinimum": 0, "description": "Khoảng mất mẫu được phép nội suy (≤ 4 ms)" },
    "invalid_gap_s":          { "type": "number", "exclusiveMinimum": 0, "description": "Khoảng mất mẫu bị đánh INVALID_GAP (> 10 ms)" },
    "hardware_version":       { "type": "string", "enum": ["hw_v1.0", "hw_v1.1"] },
    "firmware_version":       { "type": "string", "enum": ["fw_v1.0"] },
    "airpath_version":        { "type": "string", "enum": ["airpath_v1.0", "airpath_v2.0"] },
    "calibration_id":         { "type": ["string", "null"] },
    "model_path":             { "type": "string" },
    "simulation":             { "type": "boolean" }
  },
  "required": [
    "sample_rate_hz", "adc_bits", "adc_divisor", "vref_v", "divider_ratio", "vs_nominal_v",
    "sensor_offset_frac", "sensor_sens_per_kpa", "zero_adc", "filter_placement",
    "hardware_version", "firmware_version", "airpath_version", "simulation"
  ],
  "additionalProperties": false
}
